{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jobs-for-dave-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "DRAFT_BUDGET", "class_name": "DraftBudget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DraftBudget"] }]
}
